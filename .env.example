# Copy to .env and adjust for local use. Never commit a real .env file.

CHANGEGUARD_ENVIRONMENT=local
CHANGEGUARD_LOG_LEVEL=INFO

# PostgreSQL only — SQLite is not supported anywhere in this project.
CHANGEGUARD_DATABASE_URL=postgresql+psycopg://changeguard:changeguard@db:5432/changeguard

# AI provider: "mock" (default, fully offline/deterministic) or "external".
CHANGEGUARD_AI_PROVIDER=mock
CHANGEGUARD_AI_EXTERNAL_BASE_URL=
CHANGEGUARD_AI_EXTERNAL_API_KEY=

# Gate 3 confidence thresholds.
CHANGEGUARD_CONFIDENCE_APPROVAL_THRESHOLD=0.70
CHANGEGUARD_CONFIDENCE_HARD_FLOOR=0.35

# Routing policy.
CHANGEGUARD_ALLOW_CRITICAL_CAB_EXCEPTION=false
CHANGEGUARD_KILL_SWITCH_DEFAULT_ACTIVE=false

# Request/payload limits.
CHANGEGUARD_MAX_PAYLOAD_BYTES=1000000

# PostgreSQL container credentials (docker-compose only — placeholders).
POSTGRES_USER=changeguard
POSTGRES_PASSWORD=changeguard
POSTGRES_DB=changeguard
